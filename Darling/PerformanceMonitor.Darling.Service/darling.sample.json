{
  // Copy this file to darling.json next to the service binary (or point the
  // DARLING_CONFIG environment variable at it) and edit. Comments are allowed.
  "postgres": {
    "connectionString": "Host=localhost;Port=5432;Username=darling;Database=darling"
  },
  "servers": [
    {
      // Integrated auth (recommended): grant the service account VIEW SERVER STATE etc.
      "name": "SQL2022",
      "host": "SQL2022",
      "auth": "integrated",
      "excludedDatabases": []
    },
    {
      // SQL auth: run `PerformanceMonitor.Darling.Service --encrypt-password` on THIS
      // machine and paste the output below. Plaintext "password" also works for dev,
      // but the service logs a warning. The blob is machine-bound (DPAPI LocalMachine).
      "name": "PROD1",
      "host": "prod1.example.com",
      "auth": "sql",
      "username": "monitor",
      "encryptedPassword": "<output of --encrypt-password>",
      "trustServerCertificate": false,
      "encryptMode": "Mandatory",
      "excludedDatabases": [ "StageDb" ]
    }
  ],

  // The alert engine (optional section). Every default mirrors Performance Monitor Lite's:
  // cpu 80% (total mode), blocking 1, deadlock 1, poison wait 500 ms, long-running query
  // 30 min, tempdb 80%, low disk 10% / 5 GB, job multiplier 3x, failed-job lookback 60 min,
  // cooldown 5 min. Omit the whole section (or any key) for those defaults.
  // "enabled" also gates scheduled-analysis finding notifications (the analysis itself
  // always runs every 30 minutes per server and persists its findings; severity >= 1.5
  // notifies with a 6-hour per-finding cooldown — Lite's defaults, not configurable here).
  "alerts": {
    "enabled": true,
    "cpuThresholdPercent": 80,
    "cpuMode": "total", // "total" (SQL + other processes) or "sql" (SQL process only)
    "excludedDatabases": []
  },

  // SMTP alert delivery (optional). Enabled when host + from + to are all set. For an
  // authenticated relay, set username and run --encrypt-password for the password blob.
  "smtp": {
    "host": "",
    "port": 587,
    "useSsl": true,
    "username": "",
    "encryptedPassword": "",
    "from": "",
    "to": "dba-team@example.com",
    "emailCooldownMinutes": 15
  },

  // Teams / Slack incoming webhooks (optional). A channel is enabled by a non-empty URL.
  "webhooks": {
    "teamsUrl": "",
    "slackUrl": ""
  },

  // Embedded MCP server (optional): the six analysis tools (analyze_server, get_analysis_facts,
  // compare_analysis, audit_config, get_analysis_findings, mute_analysis_finding) — the same
  // analysis surface Lite and the Dashboard expose — over Streamable HTTP at
  // http://localhost:{port}. Default OFF; port 5152 avoids the Dashboard (5150) and Lite (5151)
  // defaults so all three can run on one machine.
  "mcp": {
    "enabled": false,
    "port": 5152
  }
}

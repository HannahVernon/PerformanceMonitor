<UserControl x:Class="PerformanceMonitor.Darling.Viewer.ViewerServerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PerformanceMonitor.Darling.Viewer"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             Background="Transparent">
    <!--
        One monitored server's detail surface (headless-plan W0 IA inversion): an inner tab strip
        holding the per-server surfaces relocated out of MainWindow's old flat tab list — Overview
        (the CPU-utilization and wait-time-by-category trend charts), Queries (top-50 query stats),
        Blocking (XE blocked-process reports with the DMV-snapshot fallback), and Collection Health
        (per-collector last-run status). The grids keep MainWindow's hardcoded Dark styling verbatim
        (pure relocation — no visual change); the inner tab chrome uses the shared SubTabItemStyle so
        the sub-tab hierarchy reads the same as Lite's ServerTab. Loads are lazy per inner tab (Lite's
        visible-only rule): only the active inner tab reads, and MainWindow's 60-second timer refreshes
        only the active inner tab of the visible server tab.
    -->
    <UserControl.Resources>
        <local:StatusToBrushConverter x:Key="StatusToBrush"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="EmptyHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B93A1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="480"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- Dark grid chrome shared by the per-server grids (relocated from MainWindow's
             Window.Resources — same setters, zero visual change). -->
        <Style x:Key="DarkGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#262932"/>
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="BorderBrush" Value="#2a2d35"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DarkGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1f232b"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkGridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2f3542"/>
                    <Setter Property="Foreground" Value="#E4E6EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2a2d35"/>
            <Setter Property="Background" Value="#111217"/>
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="BorderBrush" Value="#2a2d35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#111217"/>
            <Setter Property="AlternatingRowBackground" Value="#16181d"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DarkGridHeader}"/>
            <Setter Property="RowStyle" Value="{StaticResource DarkGridRow}"/>
            <Setter Property="CellStyle" Value="{StaticResource DarkGridCell}"/>
        </Style>
    </UserControl.Resources>

    <!-- Inner tab strip. Only the ACTIVE inner tab loads (Lite's visible-only rule); MainWindow's
         60-second timer refreshes only the active inner tab of the visible server tab. -->
    <TabControl x:Name="InnerTabs"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                ItemContainerStyle="{DynamicResource SubTabItemStyle}"
                SelectionChanged="InnerTabs_SelectionChanged">

        <TabItem Header="Overview">
            <!-- The two Overview trend charts, side by side. Left = CPU utilization, right = wait
                 time by category (the shared wait taxonomy the plan-viewer wait list uses). -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="CPU Utilization — SQL Server vs other processes (last 24 hours)" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <scottplot:WpfPlot x:Name="CpuTrendChart"/>
                        <TextBlock x:Name="CpuChartHintText"
                                   Style="{StaticResource EmptyHint}"
                                   Text="no CPU samples in the window yet"/>
                    </Grid>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="Wait Time by Category — top 8 categories by delta wait time (last 24 hours)" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <scottplot:WpfPlot x:Name="WaitCategoryChart"/>
                        <TextBlock x:Name="WaitChartHintText"
                                   Style="{StaticResource EmptyHint}"
                                   Text="no wait samples in the window yet"/>
                    </Grid>
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- Wait Stats Tab — copied from Lite's ServerTab.xaml (the 220px wait-type picker + metric
             combo + chart); reads rewired to Postgres, fixed 24-hour window (no custom-range picker). -->
        <TabItem Header="Wait Stats">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="4" Padding="8" Margin="0,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Select Wait Types" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Top Waits" Click="WaitTypeSelectAll_Click" Padding="6,2" Margin="0,0,4,0" FontSize="11"/>
                            <Button Content="Clear All" Click="WaitTypeClearAll_Click" Padding="6,2" FontSize="11"/>
                            <TextBlock x:Name="WaitTypeCountText" Text="0 / 30 selected" FontSize="10" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Row="2" x:Name="WaitTypeSearchBox" TextChanged="WaitTypeSearch_TextChanged"
                                 Margin="0,0,0,4" Padding="4,2"/>
                        <ListBox Grid.Row="3" x:Name="WaitTypesList" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Checked="WaitType_CheckChanged" Unchecked="WaitType_CheckChanged"
                                              Foreground="{DynamicResource ForegroundBrush}" FontSize="11">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,4,0,0">
                        <TextBlock Text="Metric:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                        <ComboBox x:Name="WaitStatsMetricCombo" SelectedIndex="0" SelectionChanged="WaitStatsMetric_SelectionChanged" FontSize="11" Padding="4,2">
                            <ComboBoxItem Content="Wait Time (ms/sec)"/>
                            <ComboBoxItem Content="Avg Wait Time (ms/wait)"/>
                        </ComboBox>
                    </StackPanel>
                    <scottplot:WpfPlot Grid.Row="1" x:Name="WaitStatsChart"/>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Queries">
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Top 50 Queries by Total Duration (last 24 hours)" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <DataGrid x:Name="QueriesGrid" Style="{StaticResource DarkGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="140"/>
                            <DataGridTextColumn Header="Query Text" Binding="{Binding QueryTextPreview}" Width="3*" SortMemberPath="QueryText">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding QueryTextTooltip}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Executions" Binding="{Binding Executions, StringFormat=N0}" Width="100"/>
                            <DataGridTextColumn Header="Total CPU (ms)" Binding="{Binding TotalCpuMs, StringFormat=N1}" Width="120"/>
                            <DataGridTextColumn Header="Total Duration (ms)" Binding="{Binding TotalElapsedMs, StringFormat=N1}" Width="140" SortDirection="Descending"/>
                            <DataGridTextColumn Header="Total Reads" Binding="{Binding TotalLogicalReads, StringFormat=N0}" Width="110"/>
                            <DataGridTextColumn Header="Last Execution (server)" Binding="{Binding LastExecutionTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="QueriesHintText"
                               Style="{StaticResource EmptyHint}"
                               Text="no query stats in the window yet"/>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- CPU Tab — copied from Lite's ServerTab.xaml CPU tab: one full-bleed chart of raw
             per-sample CPU (SQL Server vs other processes), distinct from the Overview's
             averaged-per-collection CPU trend. -->
        <TabItem Header="CPU">
            <Grid Margin="8">
                <scottplot:WpfPlot x:Name="CpuChart"/>
            </Grid>
        </TabItem>

        <!-- tempdb Tab — copied from Lite's ServerTab.xaml tempdb tab: three stacked charts —
             space usage (user/internal/version-store), total allocated size, and per-file I/O
             latency. -->
        <TabItem Header="tempdb">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,4">
                    <scottplot:WpfPlot x:Name="TempDbChart"/>
                </Border>

                <Border Grid.Row="1" Margin="0,4,0,4">
                    <scottplot:WpfPlot x:Name="TempDbSizeChart"/>
                </Border>

                <Border Grid.Row="2" Margin="0,4,0,0">
                    <scottplot:WpfPlot x:Name="TempDbFileIoChart"/>
                </Border>
            </Grid>
        </TabItem>

        <!-- File I/O Tab — copied from Lite's ServerTab.xaml File I/O tab: a nested sub-TabControl with
             "File I/O Latency" (stacked read + write latency charts, with the queued-I/O dashed overlay)
             and "File I/O Throughput" (stacked read + write MB/s charts). Placed after tempdb so it sits
             with the tempdb tab's per-file I/O chart. -->
        <TabItem Header="File I/O">
            <Grid Margin="8">
                <TabControl x:Name="FileIoSubTabs"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{DynamicResource SubTabItemStyle}"
                            SelectionChanged="FileIoSubTabs_SelectionChanged">
                    <TabItem Header="File I/O Latency">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="0,0,0,4">
                                <scottplot:WpfPlot x:Name="FileIoReadChart"/>
                            </Border>
                            <Border Grid.Row="1" Margin="0,4,0,0">
                                <scottplot:WpfPlot x:Name="FileIoWriteChart"/>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="File I/O Throughput">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="0,0,0,4">
                                <scottplot:WpfPlot x:Name="FileIoReadThroughputChart"/>
                            </Border>
                            <Border Grid.Row="1" Margin="0,4,0,0">
                                <scottplot:WpfPlot x:Name="FileIoWriteThroughputChart"/>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>

        <!-- Blocking Tab — upgraded to Lite's sub-tab structure (ServerTab.xaml:1435-1469): "Trends"
             (lock-wait rate, blocking incidents, deadlocks) and "Current Waits" (waiting-task duration
             by wait type, blocked sessions by database) precede the existing blocked-process grid,
             re-hosted unchanged as the third "Blocked Process Reports" sub-tab. Lite's Deadlocks
             sub-tab arrives in a later wave. -->
        <TabItem Header="Blocking">
            <Grid Margin="8">
                <TabControl x:Name="BlockingSubTabs"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{DynamicResource SubTabItemStyle}"
                            SelectionChanged="BlockingSubTabs_SelectionChanged">
                    <TabItem Header="Trends">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="0,0,0,4">
                                <scottplot:WpfPlot x:Name="LockWaitTrendChart"/>
                            </Border>
                            <Border Grid.Row="1" Margin="0,4,0,4">
                                <scottplot:WpfPlot x:Name="BlockingTrendChart"/>
                            </Border>
                            <Border Grid.Row="2" Margin="0,4,0,0">
                                <scottplot:WpfPlot x:Name="DeadlockTrendChart"/>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Current Waits">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="0,0,0,4">
                                <scottplot:WpfPlot x:Name="CurrentWaitsDurationChart"/>
                            </Border>
                            <Border Grid.Row="1" Margin="0,4,0,0">
                                <scottplot:WpfPlot x:Name="CurrentWaitsBlockedChart"/>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Blocked Process Reports">
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Blocked Processes — XE reports with DMV-snapshot fallback (last 24 hours)" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <DataGrid x:Name="BlockingGrid" Style="{StaticResource DarkGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Event Time (local)" Binding="{Binding EventTimeLocal, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="150"/>
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#8B93A1"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="120"/>
                                        <DataGridTextColumn Header="Blocked SPID" Binding="{Binding BlockedSpid}" Width="95"/>
                                        <DataGridTextColumn Header="Blocking SPID" Binding="{Binding BlockingSpid}" Width="95"/>
                                        <DataGridTextColumn Header="Wait Time" Binding="{Binding WaitTimeFormatted}" Width="90" SortMemberPath="WaitTimeMs"/>
                                        <DataGridTextColumn Header="Lock Mode" Binding="{Binding LockMode}" Width="90"/>
                                        <DataGridTextColumn Header="Contentious Object" Binding="{Binding ContentiousObject}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Blocked SQL" Binding="{Binding BlockedSqlPreview}" Width="2*" SortMemberPath="BlockedSqlText">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="ToolTip" Value="{Binding BlockedSqlTooltip}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Blocking SQL" Binding="{Binding BlockingSqlPreview}" Width="2*" SortMemberPath="BlockingSqlText">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="ToolTip" Value="{Binding BlockingSqlTooltip}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="BlockingHintText"
                                           Style="{StaticResource EmptyHint}"
                                           Text="no blocked-process events in the window — the XE session and the DMV snapshot are both clean"/>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>

        <TabItem Header="Collection Health">
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Collection Health" Style="{StaticResource SectionHeader}"/>
                <DataGrid x:Name="HealthGrid" Style="{StaticResource DarkGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Collector" Binding="{Binding CollectorName}" Width="2*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                    <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Last Run (local)" Binding="{Binding CollectionTimeLocal, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="1.6*"/>
                        <DataGridTextColumn Header="Rows" Binding="{Binding RowsCollected}" Width="*"/>
                        <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMs}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>

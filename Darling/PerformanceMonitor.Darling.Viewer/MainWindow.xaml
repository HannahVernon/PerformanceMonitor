<Window x:Class="PerformanceMonitor.Darling.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PerformanceMonitor.Darling.Viewer"
        xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Performance Monitor Darling"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#22252b"
        Foreground="#E4E6EB">
    <!--
        Deliberately dark-only for the M3 shell: a simple hardcoded palette consistent with the
        product's Dark theme (#22252b chrome, #111217 wells, #2a2d35 borders, #E4E6EB text) —
        the shared ThemeManager wiring comes later. ChartStyle's default theme is Dark, so the
        chart chrome matches without any theme plumbing.
    -->
    <Window.Resources>
        <local:StatusToBrushConverter x:Key="StatusToBrush"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: the server list -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Text="Servers" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="ServersHintText"
                           DockPanel.Dock="Bottom"
                           Text="no servers registered — is the Darling service running?"
                           Foreground="#8B93A1"
                           TextWrapping="Wrap"
                           Margin="2,8,2,0"
                           Visibility="Collapsed"/>
                <ListBox x:Name="ServerList"
                         Background="#111217"
                         BorderBrush="#2a2d35"
                         BorderThickness="1"
                         Foreground="#E4E6EB"
                         SelectionChanged="ServerList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#E4E6EB"/>
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="3"
                                                Margin="2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1f232b"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2f3542"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="#8B93A1"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Right: collection health over the wait trend -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Top" Text="Collection Health" Style="{StaticResource SectionHeader}"/>
                    <DataGrid x:Name="HealthGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2a2d35"
                              Background="#111217"
                              Foreground="#E4E6EB"
                              BorderBrush="#2a2d35"
                              BorderThickness="1"
                              RowBackground="#111217"
                              AlternatingRowBackground="#16181d">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#262932"/>
                                <Setter Property="Foreground" Value="#E4E6EB"/>
                                <Setter Property="BorderBrush" Value="#2a2d35"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1f232b"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#E4E6EB"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2f3542"/>
                                        <Setter Property="Foreground" Value="#E4E6EB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Collector" Binding="{Binding CollectorName}" Width="2*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                        <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Last Run (local)" Binding="{Binding CollectionTimeLocal, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="1.6*"/>
                            <DataGridTextColumn Header="Rows" Binding="{Binding RowsCollected}" Width="*"/>
                            <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMs}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <DockPanel Grid.Row="1">
                    <TextBlock DockPanel.Dock="Top" Text="Wait Stats — top 8 by delta wait time (last 24 hours)" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <scottplot:WpfPlot x:Name="WaitTrendChart"/>
                        <TextBlock x:Name="ChartHintText"
                                   Text="no wait samples in the window yet"
                                   Foreground="#8B93A1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Full-window message state: missing config / unreachable store -->
        <Border x:Name="MessageOverlay"
                Grid.Row="0"
                Background="#22252b"
                Visibility="Collapsed">
            <TextBlock x:Name="MessageText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="640"
                       FontSize="14"
                       Foreground="#E4E6EB"/>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="0,8,0,0"
                   FontSize="12"
                   Foreground="#8B93A1"/>
    </Grid>
</Window>

<Window x:Class="PerformanceMonitor.Darling.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PerformanceMonitor.Darling.Viewer"
        xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Performance Monitor Darling"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#22252b"
        Foreground="#E4E6EB">
    <!--
        Deliberately dark-only for the M3 shell: a simple hardcoded palette consistent with the
        product's Dark theme (#22252b chrome, #111217 wells, #2a2d35 borders, #E4E6EB text) —
        the shared ThemeManager wiring comes later. ChartStyle's default theme is Dark, so the
        chart chrome matches without any theme plumbing.
    -->
    <Window.Resources>
        <local:StatusToBrushConverter x:Key="StatusToBrush"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="EmptyHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B93A1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="480"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- One dark grid chrome shared by all four data grids (hoisted from the wave-1
             HealthGrid inline styles — same setters, zero visual change). -->
        <Style x:Key="DarkGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#262932"/>
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="BorderBrush" Value="#2a2d35"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DarkGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1f232b"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkGridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2f3542"/>
                    <Setter Property="Foreground" Value="#E4E6EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2a2d35"/>
            <Setter Property="Background" Value="#111217"/>
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="BorderBrush" Value="#2a2d35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#111217"/>
            <Setter Property="AlternatingRowBackground" Value="#16181d"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DarkGridHeader}"/>
            <Setter Property="RowStyle" Value="{StaticResource DarkGridRow}"/>
            <Setter Property="CellStyle" Value="{StaticResource DarkGridCell}"/>
        </Style>

        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="3,3,0,0"
                                Padding="14,6"
                                Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1f232b"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2f3542"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Recommendations rows dim when the finding's story pattern is muted (wave-3). -->
        <Style x:Key="FindingsRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Alerts-tab row emphasis, mirroring Lite's AlertRowStyle: critical/warning/resolved
             tints via the shared AlertMetricClassifier, muted rows dimmed + italic. -->
        <Style x:Key="AlertRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                    <Setter Property="Background" Value="#33DC2626"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Background" Value="#33D97706"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsResolved}" Value="True">
                    <Setter Property="Background" Value="#3322C55E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Muted}" Value="True">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dark ComboBox for the Alerts time-range picker (the only combo in this window), so it
             matches the hardcoded Dark palette instead of the default light WPF chrome. -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1f232b"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2f3542"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark button for the Alerts toolbar (Refresh / Manage Mute Rules). -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="Background" Value="#2f3542"/>
            <Setter Property="BorderBrush" Value="#3a4150"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3a4150"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1b1e24"/>
                                <Setter Property="Foreground" Value="#5c6472"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="Background" Value="#111217"/>
            <Setter Property="BorderBrush" Value="#2a2d35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#111217" BorderBrush="#2a2d35" BorderThickness="1" CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#8B93A1"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#16181d" BorderBrush="#2a2d35" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: the server list -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Text="Servers" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="ServersHintText"
                           DockPanel.Dock="Bottom"
                           Text="no servers registered — is the Darling service running?"
                           Foreground="#8B93A1"
                           TextWrapping="Wrap"
                           Margin="2,8,2,0"
                           Visibility="Collapsed"/>
                <ListBox x:Name="ServerList"
                         Background="#111217"
                         BorderBrush="#2a2d35"
                         BorderThickness="1"
                         Foreground="#E4E6EB"
                         SelectionChanged="ServerList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#E4E6EB"/>
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="3"
                                                Margin="2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1f232b"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2f3542"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="#8B93A1"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Right: the surface tabs. Only the ACTIVE tab loads (Lite's visible-only rule);
                 the 60-second refresh re-reads the active tab for the selected server. -->
            <TabControl x:Name="MainTabs"
                        Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        ItemContainerStyle="{StaticResource DarkTabItem}"
                        SelectionChanged="MainTabs_SelectionChanged">

                <TabItem Header="Overview">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Top" Text="Collection Health" Style="{StaticResource SectionHeader}"/>
                            <DataGrid x:Name="HealthGrid" Style="{StaticResource DarkGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Collector" Binding="{Binding CollectorName}" Width="2*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                                <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Last Run (local)" Binding="{Binding CollectionTimeLocal, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="1.6*"/>
                                    <DataGridTextColumn Header="Rows" Binding="{Binding RowsCollected}" Width="*"/>
                                    <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMs}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <DockPanel Grid.Row="1">
                            <TextBlock DockPanel.Dock="Top" Text="Wait Stats — top 8 by delta wait time (last 24 hours)" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <scottplot:WpfPlot x:Name="WaitTrendChart"/>
                                <TextBlock x:Name="ChartHintText"
                                           Style="{StaticResource EmptyHint}"
                                           Text="no wait samples in the window yet"/>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Queries">
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Top 50 Queries by Total Duration (last 24 hours)" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <DataGrid x:Name="QueriesGrid" Style="{StaticResource DarkGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="140"/>
                                    <DataGridTextColumn Header="Query Text" Binding="{Binding QueryTextPreview}" Width="3*" SortMemberPath="QueryText">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="ToolTip" Value="{Binding QueryTextTooltip}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Executions" Binding="{Binding Executions, StringFormat=N0}" Width="100"/>
                                    <DataGridTextColumn Header="Total CPU (ms)" Binding="{Binding TotalCpuMs, StringFormat=N1}" Width="120"/>
                                    <DataGridTextColumn Header="Total Duration (ms)" Binding="{Binding TotalElapsedMs, StringFormat=N1}" Width="140" SortDirection="Descending"/>
                                    <DataGridTextColumn Header="Total Reads" Binding="{Binding TotalLogicalReads, StringFormat=N0}" Width="110"/>
                                    <DataGridTextColumn Header="Last Execution (server)" Binding="{Binding LastExecutionTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="QueriesHintText"
                                       Style="{StaticResource EmptyHint}"
                                       Text="no query stats in the window yet"/>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Blocking">
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Blocked Processes — XE reports with DMV-snapshot fallback (last 24 hours)" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <DataGrid x:Name="BlockingGrid" Style="{StaticResource DarkGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Event Time (local)" Binding="{Binding EventTimeLocal, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="150"/>
                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#8B93A1"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="120"/>
                                    <DataGridTextColumn Header="Blocked SPID" Binding="{Binding BlockedSpid}" Width="95"/>
                                    <DataGridTextColumn Header="Blocking SPID" Binding="{Binding BlockingSpid}" Width="95"/>
                                    <DataGridTextColumn Header="Wait Time" Binding="{Binding WaitTimeFormatted}" Width="90" SortMemberPath="WaitTimeMs"/>
                                    <DataGridTextColumn Header="Lock Mode" Binding="{Binding LockMode}" Width="90"/>
                                    <DataGridTextColumn Header="Contentious Object" Binding="{Binding ContentiousObject}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Blocked SQL" Binding="{Binding BlockedSqlPreview}" Width="2*" SortMemberPath="BlockedSqlText">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="ToolTip" Value="{Binding BlockedSqlTooltip}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Blocking SQL" Binding="{Binding BlockingSqlPreview}" Width="2*" SortMemberPath="BlockingSqlText">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="ToolTip" Value="{Binding BlockingSqlTooltip}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="BlockingHintText"
                                       Style="{StaticResource EmptyHint}"
                                       Text="no blocked-process events in the window — the XE session and the DMV snapshot are both clean"/>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Recommendations">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock x:Name="FindingsHeaderText" DockPanel.Dock="Top" Text="Latest Analysis Findings" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <DataGrid x:Name="FindingsGrid"
                                          Style="{StaticResource DarkGrid}"
                                          RowStyle="{StaticResource FindingsRowStyle}"
                                          SelectionChanged="FindingsGrid_SelectionChanged"
                                          PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                                          ContextMenuOpening="FindingsGrid_ContextMenuOpening">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="MuteFindingMenuItem" Header="Mute finding" Click="MuteFinding_Click"/>
                                            <MenuItem x:Name="UnmuteFindingMenuItem" Header="Unmute finding" Click="UnmuteFinding_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding SeverityBand}" Width="100" SortMemberPath="RawSeverity" SortDirection="Descending">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{Binding SeverityBand, Converter={StaticResource StatusToBrush}}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="3*"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
                                        <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="150"/>
                                        <DataGridTextColumn Header="Muted" Binding="{Binding MutedLabel}" Width="70">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#8B93A1"/>
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="FindingsHintText"
                                           Style="{StaticResource EmptyHint}"
                                           Text="no findings — analysis runs every 30 minutes once 24h of data exists."/>
                            </Grid>
                        </DockPanel>

                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Text="Detail" Style="{StaticResource SectionHeader}"/>
                            <Border Background="#111217" BorderBrush="#2a2d35" BorderThickness="1">
                                <TextBox x:Name="FindingDetailText"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         Foreground="#E4E6EB"
                                         BorderThickness="0"
                                         Padding="8"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="select a finding to see its story, advice, and stored remediation"/>
                            </Border>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Alerts">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Time Range:" VerticalAlignment="Center" Foreground="#8B93A1" Margin="0,0,6,0"/>
                            <ComboBox x:Name="AlertsTimeRangeCombo" Width="130" VerticalAlignment="Center"
                                      Style="{StaticResource DarkCombo}"
                                      SelectionChanged="AlertsTimeRange_SelectionChanged">
                                <ComboBoxItem Content="Last 1 Hour" Tag="1"/>
                                <ComboBoxItem Content="Last 4 Hours" Tag="4"/>
                                <ComboBoxItem Content="Last 24 Hours" Tag="24" IsSelected="True"/>
                                <ComboBoxItem Content="Last 7 Days" Tag="168"/>
                                <ComboBoxItem Content="All" Tag="8760"/>
                            </ComboBox>
                            <Button Content="Refresh" Margin="10,0,0,0" Padding="12,4" Style="{StaticResource DarkButton}" Click="AlertsRefresh_Click"/>
                            <Button Content="Manage Mute Rules…" Margin="8,0,0,0" Padding="12,4" Style="{StaticResource DarkButton}" Click="ManageMuteRules_Click"/>
                            <TextBlock x:Name="AlertsCountText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#8B93A1"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <DataGrid x:Name="AlertsGrid"
                                      Style="{StaticResource DarkGrid}"
                                      RowStyle="{StaticResource AlertRowStyle}"
                                      SelectionChanged="AlertsGrid_SelectionChanged"
                                      PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Create mute rule from this alert…" Click="CreateMuteRuleFromAlert_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time (local)" Binding="{Binding TimeLocal}" Width="150" SortMemberPath="AlertTime" SortDirection="Descending"/>
                                    <DataGridTextColumn Header="Alert Type" Binding="{Binding MetricName}" Width="1.6*"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding CurrentValueDisplay}" Width="120"/>
                                    <DataGridTextColumn Header="Threshold" Binding="{Binding ThresholdValueDisplay}" Width="110"/>
                                    <DataGridTextColumn Header="Channel" Binding="{Binding NotificationType}" Width="95"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="AlertsHintText"
                                       Style="{StaticResource EmptyHint}"
                                       Text="no alerts recorded in the selected time range"/>
                        </Grid>

                        <DockPanel Grid.Row="3">
                            <TextBlock DockPanel.Dock="Top" Text="Alert Detail" Style="{StaticResource SectionHeader}"/>
                            <Border Background="#111217" BorderBrush="#2a2d35" BorderThickness="1">
                                <TextBox x:Name="AlertDetailText"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         Foreground="#E4E6EB"
                                         BorderThickness="0"
                                         Padding="8"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="select an alert to see its detail and dedup fingerprint"/>
                            </Border>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Full-window message state: missing config / unreachable store -->
        <Border x:Name="MessageOverlay"
                Grid.Row="0"
                Background="#22252b"
                Visibility="Collapsed">
            <TextBlock x:Name="MessageText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="640"
                       FontSize="14"
                       Foreground="#E4E6EB"/>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="0,8,0,0"
                   FontSize="12"
                   Foreground="#8B93A1"/>
    </Grid>
</Window>
